# Entorno virtual (cada persona usa el suyo; requirements.txt lo reproduce)
venv/
.venv/

# Credenciales: el .env real nunca se sube.
# Se permite únicamente la plantilla .env.example.
.env
.env.*
!.env.example

# Caché generado por Python y pytest
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Editores y sistema operativo
.vscode/
.idea/
.DS_Store
Thumbs.db

#Datos locales (historial de conversaciones, etc.)
data/
*.db