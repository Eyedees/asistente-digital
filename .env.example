# Copia este archivo a .env y rellena tu clave real.
# En Windows (PowerShell): Copy-Item .env.example .env
# En macOS/Linux:          cp .env.example .env

GROQ_API_KEY=tu_clave_aqui

# Opcionales para la entrada por voz (faster-whisper local)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=es
